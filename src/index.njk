---
layout: base.njk
title: "Ride More. Know More."
description: "BikeLabs — honest motorcycle gear reviews, bike reviews, how-tos and moto culture. Built for riders."
---

{% set featured = collections.allArticles | first %}

<!-- Hero -->
{% if featured %}
<div class="hero-wrap">
<section class="hero">
  {% if featured.data.image %}
  <img class="hero-img" src="{{ featured.data.image }}" alt="{{ featured.data.title }}" fetchpriority="high" decoding="async">
  {% else %}
  <div style="background:#1e1e1e;aspect-ratio:16/9;width:100%;display:flex;align-items:center;justify-content:center;">
    <span style="font-family:'Barlow Condensed',sans-serif;font-size:4rem;font-weight:700;color:#FF6B00;opacity:0.2;text-transform:uppercase;">BikeLabs</span>
  </div>
  {% endif %}
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <span class="hero-tag">{{ featured.data.section or "Latest" }}</span>
    <h2 class="hero-title">{{ featured.data.title }}</h2>
    <p class="hero-excerpt">{{ featured.data.description }}</p>
    <a href="{{ featured.url | url }}" class="btn-primary">Read More &rarr;</a>
  </div>
</section>
</div>
{% endif %}

<!-- Tagline -->
<div class="tagline-strip">
  <p>Ride More. Know More.</p>
</div>

<!-- Latest Reviews -->
{% if collections.reviews | length %}
<section class="section">
  <div class="section-header">
    <h2 class="section-title">Latest Reviews</h2>
    <a href="{{ '/reviews/' | url }}" class="section-link">All Reviews &rarr;</a>
  </div>
  <div class="card-grid">
    {% for article in collections.reviews | slice(0, 3) %}
    <article class="article-card">
      <a href="{{ article.url | url }}">
        {% if article.data.image %}
        <div class="card-img-wrap">
          <img src="{{ article.data.image }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
        </div>
        {% else %}
        <div class="card-img-placeholder"><span>{{ article.data.category or "Review" }}</span></div>
        {% endif %}
      </a>
      <div class="card-body">
        <span class="card-tag">{{ article.data.category or article.data.section }}</span>
        <h3 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h3>
        <p class="card-excerpt">{{ article.data.description }}</p>
        <p class="card-meta">{{ article.date | dateDisplay }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}

{% include "partials/ad-slot.njk" %}

<!-- Latest Bikes -->
{% if collections.bikes | length %}
<section class="section" style="padding-top:0;">
  <div class="section-header">
    <h2 class="section-title">Bikes</h2>
    <a href="{{ '/bikes/' | url }}" class="section-link">All Bikes &rarr;</a>
  </div>
  <div class="card-grid-2">
    {% for article in collections.bikes | slice(0, 2) %}
    <article class="article-card">
      <a href="{{ article.url | url }}">
        {% if article.data.image %}
        <div class="card-img-wrap">
          <img src="{{ article.data.image }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
        </div>
        {% else %}
        <div class="card-img-placeholder"><span>Bikes</span></div>
        {% endif %}
      </a>
      <div class="card-body">
        <span class="card-tag">Bikes</span>
        <h3 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h3>
        <p class="card-excerpt">{{ article.data.description }}</p>
        <p class="card-meta">{{ article.date | dateDisplay }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}

<!-- Culture & Routes -->
{% if collections.culture | length %}
<section class="section" style="padding-top:0;">
  <div class="section-header">
    <h2 class="section-title">Culture &amp; Routes</h2>
    <a href="{{ '/culture/' | url }}" class="section-link">All Culture &rarr;</a>
  </div>
  <div class="card-grid-2">
    {% for article in collections.culture | slice(0, 2) %}
    <article class="article-card">
      <a href="{{ article.url | url }}">
        {% if article.data.image %}
        <div class="card-img-wrap">
          <img src="{{ article.data.image }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
        </div>
        {% else %}
        <div class="card-img-placeholder"><span>Culture</span></div>
        {% endif %}
      </a>
      <div class="card-body">
        <span class="card-tag">Culture</span>
        <h3 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h3>
        <p class="card-excerpt">{{ article.data.description }}</p>
        <p class="card-meta">{{ article.date | dateDisplay }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}

<!-- Tools Section -->
<section class="section tools-section">
  <div style="max-width:var(--max-site);margin:0 auto;padding:0 1rem;">
    <div class="section-header">
      <h2 class="section-title">Online Tools</h2>
    </div>
    <div class="card-grid-2x2">
      <div class="tool-card-home">
        <div class="tool-icon">⚙️</div>
        <h3>Gear Ratio &amp; Sprocket Calculator</h3>
        <p>See how sprocket changes affect top speed per gear. Essential before any gearing mod.</p>
        <a href="{{ '/tools/gear-ratio-calculator/' | url }}" class="btn-tool">Use Calculator →</a>
      </div>
      <div class="tool-card-home">
        <div class="tool-icon">🛞</div>
        <h3>Tyre Size Calculator</h3>
        <p>Decode any tyre code. Compare OEM vs aftermarket sizing and see the speedo impact.</p>
        <a href="{{ '/tools/tyre-size-calculator/' | url }}" class="btn-tool">Use Calculator →</a>
      </div>
      <div class="tool-card-home">
        <div class="tool-icon">⛽</div>
        <h3>Fuel Range Calculator</h3>
        <p>Know exactly how far you can ride before hitting reserve. Plan every long trip with confidence.</p>
        <a href="{{ '/tools/fuel-range-calculator/' | url }}" class="btn-tool">Use Calculator →</a>
      </div>
      <div class="tool-card-home">
        <div class="tool-icon">⚡</div>
        <h3>Power-to-Weight Calculator</h3>
        <p>Find out where your bike sits — learner to hyperbike — and compare against similar machines.</p>
        <a href="{{ '/tools/power-weight-calculator/' | url }}" class="btn-tool">Use Calculator →</a>
      </div>
      <div class="tool-card-home">
        <div class="tool-icon">🏁</div>
        <h3>Top Speed Calculator</h3>
        <p>Calculate theoretical top speed at redline for every gear. Model any gearing setup.</p>
        <a href="{{ '/tools/top-speed-calculator/' | url }}" class="btn-tool">Use Calculator →</a>
      </div>
      <div class="tool-card-home">
        <div class="tool-icon">🧍</div>
        <h3>Ergonomics &amp; Seat Height Simulator</h3>
        <p>Find out if a bike fits you before you buy. Enter your inseam and get a confidence rating.</p>
        <a href="{{ '/tools/ergonomics-fitment-simulator/' | url }}" class="btn-tool">Open Simulator →</a>
      </div>
      <div class="tool-card-home">
        <div class="tool-icon">💰</div>
        <h3>Commuter Cost Calculator</h3>
        <p>See your real annual running costs and how much you save versus a car — calculated to the cent.</p>
        <a href="{{ '/tools/commuter-ownership-calculator/' | url }}" class="btn-tool">Use Calculator →</a>
      </div>
      <div class="tool-card-home">
        <div class="tool-icon">📐</div>
        <h3>Suspension Geometry Calculator</h3>
        <p>Calculate mechanical trail from rake and fork offset. Know if your geometry suits track or highway.</p>
        <a href="{{ '/tools/suspension-geometry-calculator/' | url }}" class="btn-tool">Use Calculator →</a>
      </div>
    </div>
  </div>
</section>
