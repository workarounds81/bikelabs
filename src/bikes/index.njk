---
layout: base.njk
title: "Bike Reviews"
description: "Motorcycle reviews and comparisons — from budget commuters to premium adventure bikes."
permalink: /bikes/
---

<div class="section-index">
  <header class="section-index-header">
    <h1 class="section-index-title">Bikes</h1>
    <p class="section-index-desc">Motorcycle reviews and shootouts. Find your next ride.</p>
  </header>

  {% if collections.bikes | length %}
  <div class="card-grid">
    {% for article in collections.bikes %}
    <article class="article-card">
      <a href="{{ article.url | url }}">
        {% if article.data.image %}
        <div class="card-img-wrap">
          <img src="{{ article.data.image }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
        </div>
        {% else %}
        <div class="card-img-placeholder"><span>Bikes</span></div>
        {% endif %}
      </a>
      <div class="card-body">
        <span class="card-tag">{{ article.data.category or "Bikes" }}</span>
        <h2 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h2>
        <p class="card-excerpt">{{ article.data.description }}</p>
        <p class="card-meta">{{ article.date | dateDisplay }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p style="color:var(--text-muted);">Bike reviews coming soon.</p>
  {% endif %}
</div>
