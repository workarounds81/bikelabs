---
layout: base.njk
title: "Culture & Routes"
description: "Motorcycle culture, riding routes, moto travel, and rider stories from around the world."
permalink: /culture/
---

<div class="section-index">
  <header class="section-index-header">
    <h1 class="section-index-title">Culture &amp; Routes</h1>
    <p class="section-index-desc">Routes, travel stories, lifestyle and moto culture from riders worldwide.</p>
  </header>

  {% if collections.culture | length %}
  <div class="card-grid">
    {% for article in collections.culture %}
    <article class="article-card">
      <a href="{{ article.url | url }}">
        {% if article.data.image %}
        <div class="card-img-wrap">
          <img src="{{ article.data.image }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
        </div>
        {% else %}
        <div class="card-img-placeholder"><span>Culture</span></div>
        {% endif %}
      </a>
      <div class="card-body">
        <span class="card-tag">{{ article.data.category or "Culture" }}</span>
        <h2 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h2>
        <p class="card-excerpt">{{ article.data.description }}</p>
        <p class="card-meta">{{ article.date | dateDisplay }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p style="color:var(--text-muted);">Culture articles coming soon.</p>
  {% endif %}
</div>
