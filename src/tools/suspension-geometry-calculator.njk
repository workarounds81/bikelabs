              <div class="gauge-track">
                <div class="gauge-fill" id="sg-gauge-fill" style="width:0%"></div>
                <div class="gauge-marker" id="sg-gauge-marker" style="left:0%"></div>
              </div>
              <div class="gauge-labels"><span>50mm</span><span>80mm</span><span>110mm</span><span>130mm</span><span>160mm+</span></div>
