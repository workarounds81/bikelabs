<script>
var PRESETS = {
  sport:     { rake: 24.0, offset: 32, wheel: '17' },
  naked:     { rake: 25.5, offset: 28, wheel: '17' },
  adventure: { rake: 27.0, offset: 25, wheel: '21' },
  cruiser:   { rake: 32.0, offset: 10, wheel: '21' }
};

function setSelectByValue(id, value) {
  var el = document.getElementById(id);
  if (!el) return;
  for (var i = 0; i < el.options.length; i++) {
    if (el.options[i].value === String(value)) { el.selectedIndex = i; return; }
  }
}

function loadPreset(key) {
  if (!key || !PRESETS[key]) return;
  var p = PRESETS[key];
  document.getElementById('rake-angle').value = p.rake;
  document.getElementById('fork-offset').value = p.offset;
  setSelectByValue('wheel-diameter', p.wheel);
  // Reset preset select so the same preset can be reloaded
  setTimeout(function () {
    document.getElementById('geometry-preset').value = '';
  }, 100);
  calculate();
}

function calculate() {
  var wheelIn = parseFloat(document.getElementById('wheel-diameter').value);
  var rake = parseFloat(document.getElementById('rake-angle').value);
  var offset = parseFloat(document.getElementById('fork-offset').value);

  if (isNaN(wheelIn) || isNaN(rake) || isNaN(offset)) return;

  var rakeRad = rake * Math.PI / 180;
  var wheelRadiusMM = (wheelIn * 25.4) / 2;

  // trail = wheelRadius * tan(rake) - forkOffset / cos(rake)
  var trail = wheelRadiusMM * Math.tan(rakeRad) - offset / Math.cos(rakeRad);
  var trailRounded = Math.round(trail * 10) / 10;

  // Update hero value
  document.getElementById('trail-value').textContent = trailRounded.toFixed(1);

  // Classification
  var label, desc, badgeClass;
  if (trail < 60) {
    label = 'Danger Zone — Speed Wobble Risk';
    desc = 'Trail is critically short. This configuration is unstable at speed.';
    badgeClass = 'badge-red';
  } else if (trail <= 85) {
    label = 'Track / Race Geometry';
    desc = 'Maximum cornering agility. Suited to closed circuit use. Twitchy at highway speeds.';
    badgeClass = 'badge-orange';
  } else if (trail <= 110) {
    label = 'Sport / All-Round Geometry';
    desc = 'Excellent balance of agility and stability. Ideal for most riders.';
    badgeClass = 'badge-green';
  } else if (trail <= 130) {
    label = 'Touring / Comfort Geometry';
    desc = 'High-speed stability prioritised. Reduced low-speed agility.';
    badgeClass = 'badge-blue';
  } else {
    label = 'Cruiser / Long-Haul Geometry';
    desc = 'Very stable in a straight line. Heavy steering effort at low speeds.';
    badgeClass = 'badge-blue';
  }

  var badge = document.getElementById('trail-badge');
  badge.textContent = label;
  badge.className = 'trail-badge ' + badgeClass;
  document.getElementById('trail-desc').textContent = desc;

  // Gauge: scale 50–160mm → 0–100%
  var gaugeMin = 50, gaugeMax = 160;
  var pct = Math.max(0, Math.min(100, ((trail - gaugeMin) / (gaugeMax - gaugeMin)) * 100));
  var needle = document.getElementById('trail-needle');
  needle.style.display = '';
  needle.style.left = pct.toFixed(1) + '%';
  document.getElementById('trail-gauge-marker-label').textContent = trailRounded.toFixed(1) + 'mm';

  // Detail row
  document.getElementById('detail-rake').textContent = rake.toFixed(1) + '°';
  document.getElementById('detail-offset').textContent = offset.toFixed(0) + ' mm';
  document.getElementById('detail-radius').textContent = wheelRadiusMM.toFixed(1) + ' mm';
  document.getElementById('detail-trail').textContent = trailRounded.toFixed(1) + ' mm';
}

// Calculate on load with defaults
calculate();
</script>
