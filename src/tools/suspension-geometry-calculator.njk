<div class="tool-page">
  <div>
    <h1>Suspension Geometry Calculator</h1>
    <p class="tool-intro" style="text-align:center">Calculate motorcycle trail from rake, fork offset, and wheel size. Understand how geometry affects handling character.</p>
    <div class="tool-layout">
      <aside class="tool-sidebar"><div class="ad-slot"><!-- AdSense 160×600 --></div></aside>
      <div class="tool-main">
        <div class="tool-card">

          <h2>Quick Presets</h2>
          <div class="presets-row">
            <button class="preset-btn" onclick="sgApplyPreset(24, 32, 17)">Sport (24° / 32mm / 17")</button>
            <button class="preset-btn" onclick="sgApplyPreset(25.5, 28, 17)">Naked (25.5° / 28mm / 17")</button>
            <button class="preset-btn" onclick="sgApplyPreset(27, 25, 21)">Adventure (27° / 25mm / 21")</button>
            <button class="preset-btn" onclick="sgApplyPreset(32, 10, 21)">Cruiser (32° / 10mm / 21")</button>
          </div>

          <h2>Geometry Inputs</h2>
          <div class="selector-row">
            <div class="form-group">
              <label for="sg-wheel">Front Wheel Diameter (in)</label>
              <select id="sg-wheel">
                <option value="17" selected>17"</option>
                <option value="18">18"</option>
                <option value="19">19"</option>
                <option value="21">21"</option>
              </select>
            </div>
            <div class="form-group">
              <label for="sg-rake">Rake Angle (degrees)</label>
              <input type="number" id="sg-rake" value="24.5" min="15" max="45" step="0.1">
            </div>
            <div class="form-group">
              <label for="sg-offset">Fork Offset (mm)</label>
              <input type="number" id="sg-offset" value="32" min="0" max="80" step="1">
            </div>
