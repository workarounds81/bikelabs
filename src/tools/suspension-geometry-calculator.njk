<script>
(function () {
  var GAUGE_MIN = 50;
  var GAUGE_MAX = 160;

  function sgCalculate() {
    var wheelIn = parseFloat(document.getElementById('sg-wheel').value);
    var rake = parseFloat(document.getElementById('sg-rake').value);
    var forkOffset = parseFloat(document.getElementById('sg-offset').value);

    if (isNaN(wheelIn) || isNaN(rake) || isNaN(forkOffset)) return;

    var rakeRad = rake * Math.PI / 180;
    var wheelRadiusMM = (wheelIn * 25.4) / 2;
    var trail = (wheelRadiusMM * Math.sin(rakeRad)) / Math.cos(rakeRad) - forkOffset / Math.cos(rakeRad);

    document.getElementById('sg-trail-val').textContent = trail.toFixed(1);
    document.getElementById('sg-stat-rake').textContent = rake.toFixed(1);
    document.getElementById('sg-stat-offset').textContent = forkOffset.toFixed(0);
    document.getElementById('sg-stat-wheel').textContent = wheelIn + '"';

    // Classification
    var badge = document.getElementById('sg-class-badge');
    var cls, label;
    if (trail < 60) {
      cls = 'geo-class--red'; label = '⚠️ Danger Zone — Speed Wobble Risk';
    } else if (trail <= 85) {
      cls = 'geo-class--orange'; label = 'Track / Race Geometry';
    } else if (trail <= 110) {
      cls = 'geo-class--green'; label = 'Sport / All-Round Geometry';
    } else if (trail <= 130) {
      cls = 'geo-class--blue'; label = 'Touring / Comfort Geometry';
    } else {
      cls = 'geo-class--blue'; label = 'Cruiser / Long-Haul Geometry';
    }
    badge.className = 'geo-class ' + cls;
    badge.textContent = label;

    // Gauge
    var pct = Math.min(Math.max((trail - GAUGE_MIN) / (GAUGE_MAX - GAUGE_MIN) * 100, 0), 100);
    document.getElementById('sg-gauge-fill').style.width = pct + '%';
    document.getElementById('sg-gauge-marker').style.left = pct + '%';
  }

  // Live listeners
  ['sg-wheel', 'sg-rake', 'sg-offset'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', sgCalculate);
  });

  // Presets
  window.sgApplyPreset = function (rake, offset, wheel) {
    document.getElementById('sg-rake').value = rake;
    document.getElementById('sg-offset').value = offset;
    var wSel = document.getElementById('sg-wheel');
    for (var i = 0; i < wSel.options.length; i++) {
      if (parseFloat(wSel.options[i].value) === wheel) { wSel.selectedIndex = i; break; }
    }
    sgCalculate();
  };

  // Initial calculation on page load
  sgCalculate();
}());
</script>
