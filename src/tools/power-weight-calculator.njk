<script>
(function(){
  var hpI=document.getElementById('hp'),kwI=document.getElementById('kw');
  hpI.addEventListener('input',function(){kwI.value=(+this.value*0.7457).toFixed(1);});
  kwI.addEventListener('input',function(){hpI.value=(+this.value/0.7457).toFixed(0);});
})();

BikeFinder.init('bike-finder-pw', function(spec) {
  var container=document.getElementById('bike-finder-pw');
  var weightUnit=document.getElementById('api-weight-unit').value;
  var notes=[],hpVal=null,kwVal=null,kgVal=null;
  if(spec.power){
    var hpM=spec.power.match(/([\d.]+)\s*HP/i);
    var kwM=spec.power.match(/([\d.]+)\s*kW/i);
    if(hpM)hpVal=parseFloat(hpM[1]);
    if(kwM)kwVal=parseFloat(kwM[1]);
    if(hpVal&&!kwVal)kwVal=hpVal*0.7457;
    if(kwVal&&!hpVal)hpVal=kwVal/0.7457;
    if(hpVal){document.getElementById('hp').value=hpVal.toFixed(1);document.getElementById('kw').value=kwVal.toFixed(1);notes.push('Power: '+hpVal.toFixed(1)+' HP applied.');}
    else notes.push('Power data missing — please input manually.');
  } else {
    notes.push('Power data missing — please input manually.');
  }
  var weightStr=spec.total_weight||spec.dry_weight||spec.wet_weight;
  if(weightStr){
    var kgM=weightStr.match(/([\d.]+)\s*kg/i);
    var lbM=weightStr.match(/([\d.]+)\s*(?:lbs?|pounds?)/i);
    if(weightUnit==='kg'&&kgM)kgVal=parseFloat(kgM[1]);
    else if(weightUnit==='lbs'&&lbM)kgVal=parseFloat(lbM[1])*0.453592;
    else if(kgM)kgVal=parseFloat(kgM[1]);
    else if(lbM)kgVal=parseFloat(lbM[1])*0.453592;
    if(kgVal){document.getElementById('kg').value=kgVal.toFixed(1);notes.push('Weight: '+kgVal.toFixed(1)+' kg applied.');}
    else notes.push('Weight data missing — please input manually.');
  } else {
    notes.push('Weight data missing — please input manually.');
  }
  if(hpVal&&kgVal){calcPW();notes.push('Ratio calculated automatically.');}
  showLookupStatus(container,(spec.make||'')+' '+(spec.model||'')+' '+(spec.year||'')+' — '+notes.join(' '),hpVal&&kgVal?'success':'warn');
});

function calcPW(){
  var hp=+document.getElementById('hp').value;
  var kw=+document.getElementById('kw').value;
  var kg=+document.getElementById('kg').value;
  document.getElementById('pw-hp-kg').textContent=(hp/kg).toFixed(3);
  document.getElementById('pw-kw-kg').textContent=(kw/kg).toFixed(3);
  var n=kw/kg,cat,badge;
  if(n<0.10){cat='b-learner';badge='Learner';}
  else if(n<0.20){cat='b-everyday';badge='Everyday Sports';}
  else if(n<0.30){cat='b-performance';badge='Performance';}
  else if(n<0.40){cat='b-superbike';badge='Superbike';}
  else{cat='b-hyper';badge='Hyperbike';}
  document.querySelectorAll('.bench-table tr').forEach(r=>r.classList.remove('active'));
  document.getElementById(cat).classList.add('active');
  document.getElementById('pw-badge').textContent=badge;
  document.getElementById('results').style.display='block';
}
</script>
