<script>
BikeFinder.init('bike-finder-tyre', function(spec) {
  var container=document.getElementById('bike-finder-tyre');
  var pos=document.getElementById('api-tyre-pos').value;
  var tyreStr=pos==='front'?spec.front_tire:spec.rear_tire;
  var label=pos==='front'?'Front':'Rear';
  if(!tyreStr){showLookupStatus(container,'Technical specifications incomplete — '+label.toLowerCase()+' tyre data missing. Please input manually.','warn');return;}
  var t=parseTyreCode(tyreStr);
  if(!t){showLookupStatus(container,'Could not parse tyre code "'+tyreStr+'". Please input manually.','warn');return;}
  document.getElementById('w1').value=t.width;
  document.getElementById('a1').value=t.aspect;
  document.getElementById('r1').value=t.rim;
  showLookupStatus(container,(spec.make||'')+' '+(spec.model||'')+' '+(spec.year||'')+' — '+label+' tyre '+tyreStr+' loaded into Current Tyre fields.','success');
});

function parseTyreCalc(w,a,r){var sw=w*a/100;var dia=sw*2+r*25.4;return{sw:sw,dia:dia,circ:Math.PI*dia};}
function calcTyre(){
  var t1=parseTyreCalc(+document.getElementById('w1').value,+document.getElementById('a1').value,+document.getElementById('r1').value);
  var t2=parseTyreCalc(+document.getElementById('w2').value,+document.getElementById('a2').value,+document.getElementById('r2').value);
  document.getElementById('s1').textContent=t1.sw.toFixed(1)+' mm';
  document.getElementById('d1').textContent=t1.dia.toFixed(1)+' mm';
  document.getElementById('c1').textContent=t1.circ.toFixed(0)+' mm';
  document.getElementById('s2').textContent=t2.sw.toFixed(1)+' mm';
  document.getElementById('d2').textContent=t2.dia.toFixed(1)+' mm';
  document.getElementById('c2').textContent=t2.circ.toFixed(0)+' mm';
  var diff=((t2.circ-t1.circ)/t1.circ*100).toFixed(1);
  document.getElementById('speedo-note').textContent=diff==0?'No change to speedo reading.':
    'The alternative tyre diameter differs by '+Math.abs(diff)+'%. Your speedo will '+
    (diff>0?'under-read by '+Math.abs(diff)+'% (actual speed is higher).':'over-read by '+Math.abs(diff)+'% (actual speed is lower).');
  document.getElementById('results').style.display='block';
}
</script>
