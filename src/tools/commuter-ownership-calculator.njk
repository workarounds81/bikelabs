</style>

<script>
(function () {
  function fmt(n) { return '$' + n.toFixed(2); }

  BikeFinder.init('bike-finder-co', function (spec) {
    var container = document.getElementById('bike-finder-co');
    var filled = [];

    if (spec.displacement) {
      var dispStr = String(spec.displacement);
      var ccMatch = dispStr.match(/([\d,]+)\s*cc/i) || dispStr.match(/^([\d,]+)$/);
      if (ccMatch) {
        var cc = parseInt(ccMatch[1].replace(/,/g, ''));
        document.getElementById('engine-cc').value = cc;

        // Tiered fuel consumption estimate
        var fc;
        if (cc < 250) fc = 3.0;
        else if (cc < 500) fc = 4.0;
        else if (cc < 750) fc = 5.0;
        else if (cc <= 1000) fc = 6.0;
        else fc = 7.0;
        document.getElementById('fuel-consumption').value = fc;

        // Tiered tyre defaults
        var tyreCost, tyreInterval;
        if (cc < 500) { tyreCost = 100; tyreInterval = 12000; }
        else if (cc <= 1000) { tyreCost = 150; tyreInterval = 10000; }
        else { tyreCost = 220; tyreInterval = 7000; }
        document.getElementById('tyre-cost').value = tyreCost;
        document.getElementById('tyre-interval').value = tyreInterval;

        filled.push('engine size', 'fuel consumption estimate', 'tyre defaults');
      }
    }

    showLookupStatus(container,
      filled.length
        ? 'Pre-filled: ' + filled.join(', ') + '. Adjust if needed.'
        : 'Spec loaded — displacement not available for this model.',
      filled.length ? 'success' : 'warn');
  });

  window.calculateOwnership = function () {
    var cc = parseFloat(document.getElementById('engine-cc').value);
    var fuelL100 = parseFloat(document.getElementById('fuel-consumption').value);
    var weeklyKm = parseFloat(document.getElementById('weekly-km').value);
    var weeksRidden = parseFloat(document.getElementById('weeks-ridden').value);
    var fuelPrice = parseFloat(document.getElementById('fuel-price').value);
    var purchasePrice = parseFloat(document.getElementById('purchase-price').value);

    var tyreCost = parseFloat(document.getElementById('tyre-cost').value);
    var tyreInterval = parseFloat(document.getElementById('tyre-interval').value);
    var oilCost = parseFloat(document.getElementById('oil-cost').value);
    var oilInterval = parseFloat(document.getElementById('oil-interval').value);

    var annualKm = weeklyKm * weeksRidden;

    // --- Bike costs ---
    var bikeFuel = (annualKm / 100) * fuelL100 * fuelPrice;
    var bikeTyres = (annualKm / tyreInterval) * tyreCost;
    var bikeOil = (annualKm / oilInterval) * oilCost;

    var bikeTotal = bikeFuel + bikeTyres + bikeOil;

    // --- Car costs ---
    var carFuelL100 = 9.0;
    var carFuel = (annualKm / 100) * carFuelL100 * fuelPrice;
    // Car tyres: £320/set every 25000km (2 axles)
    var carTyres = (annualKm / 25000) * 320;
    // Car oil: every 10000km, £60
    var carOil = (annualKm / 10000) * 60;
    var carTotal = carFuel + carTyres + carOil;

    var saving = carTotal - bikeTotal;

    var paybackHtml = '';
    if (!isNaN(purchasePrice) && purchasePrice > 0 && saving > 0) {
      var paybackYears = purchasePrice / saving;
      paybackHtml = '<p class="payback-note">At this saving rate, your $' + purchasePrice.toLocaleString() + ' motorcycle pays for itself in <strong style="color:#f0f0f0">' + paybackYears.toFixed(1) + ' years</strong> (' + Math.round(paybackYears * 12) + ' months) compared to car commuting costs.</p>';
    }

    document.getElementById('co-results-content').innerHTML =
      '<div class="cost-grid">'
      + '<div class="cost-card cost-card--bike">'
      + '<h3>Motorcycle — Annual</h3>'
      + '<div class="cost-line"><span>Fuel (' + annualKm.toFixed(0) + ' km)</span><span>' + fmt(bikeFuel) + '</span></div>'
      + '<div class="cost-line"><span>Tyres (per ' + tyreInterval.toLocaleString() + ' km)</span><span>' + fmt(bikeTyres) + '</span></div>'
      + '<div class="cost-line"><span>Oil &amp; Service (per ' + oilInterval.toLocaleString() + ' km)</span><span>' + fmt(bikeOil) + '</span></div>'
      + '<div class="cost-line cost-total-line"><span>Total</span><span>' + fmt(bikeTotal) + '</span></div>'
      + '</div>'
      + '<div class="cost-card">'
      + '<h3>Car — Annual</h3>'
      + '<div class="cost-line"><span>Fuel (9.0 L/100km)</span><span>' + fmt(carFuel) + '</span></div>'
      + '<div class="cost-line"><span>Tyres (per 25,000 km)</span><span>' + fmt(carTyres) + '</span></div>'
      + '<div class="cost-line"><span>Oil &amp; Service</span><span>' + fmt(carOil) + '</span></div>'
      + '<div class="cost-line cost-total-line"><span>Total</span><span>' + fmt(carTotal) + '</span></div>'
      + '</div>'
      + '</div>'
      + '<div class="saving-banner">'
      + '<span class="label">Annual Saving vs Car</span>'
      + '<span class="amount">' + (saving >= 0 ? '+' : '') + fmt(saving) + '</span>'
      + '</div>'
      + paybackHtml;

    var resultsEl = document.getElementById('co-results');
    resultsEl.style.display = '';
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
}());
</script>
