<div class="tool-page">
  <div>
    <h1>Commuter Ownership Calculator</h1>
    <p class="tool-intro" style="text-align:center">Compare the true annual running cost of commuting by motorcycle versus car — fuel, tyres, and servicing included.</p>
    <div class="tool-layout">
      <aside class="tool-sidebar"><div class="ad-slot"><!-- AdSense 160×600 --></div></aside>
      <div class="tool-main">
        <div class="tool-card">

          <h2>Find Your Bike</h2>
          <div id="bike-finder-co" class="api-lookup-block"></div>

          <h2>Bike Setup</h2>
          <div class="selector-row">
            <div class="form-group">
              <label for="co-engine-cc">Engine Size (cc)</label>
              <input type="number" id="co-engine-cc" value="650" min="50" max="2500" step="1" oninput="coUpdateFuelEstimate()">
            </div>
            <div class="form-group">
              <label for="co-fuel-use">Fuel Consumption (L/100km)</label>
              <input type="number" id="co-fuel-use" value="5.5" min="2" max="15" step="0.1">
            </div>
          </div>

          <h2>Commute &amp; Costs</h2>
          <div class="selector-row">
            <div class="form-group">
              <label for="co-weekly-km">Weekly Commute (km)</label>
              <input type="number" id="co-weekly-km" value="150" min="10" max="2000" step="5">
            </div>
            <div class="form-group">
              <label for="co-fuel-price">Fuel Price (£/litre)</label>
              <input type="number" id="co-fuel-price" value="1.85" min="0.5" max="5" step="0.01">
            </div>
            <div class="form-group">
              <label for="co-weeks">Weeks Ridden Per Year</label>
              <input type="number" id="co-weeks" value="48" min="1" max="52" step="1">
            </div>
          </div>

          <h2>Optional: Purchase Price</h2>
          <div class="selector-row">
            <div class="form-group">
              <label for="co-purchase">Bike Purchase Price (£, optional)</label>
              <input type="number" id="co-purchase" placeholder="e.g. 5500" min="0" max="100000" step="100">
            </div>
          </div>

          <button class="btn-calculate" onclick="coCalculate()">Calculate Costs</button>

          <div class="results" id="co-results" style="display:none">
            <div class="cost-grid">
              <div class="cost-col cost-col--bike">
                <div class="cost-col__title">Motorcycle</div>
                <div class="cost-line"><span class="cost-line__label">Fuel</span><span class="cost-line__val" id="co-bike-fuel">—</span></div>
                <div class="cost-line"><span class="cost-line__label">Tyres</span><span class="cost-line__val" id="co-bike-tyres">—</span></div>
                <div class="cost-line"><span class="cost-line__label">Oil / Service</span><span class="cost-line__val" id="co-bike-oil">—</span></div>
                <div class="cost-total"><span>Annual Total</span><span class="cost-total__val" id="co-bike-total">—</span></div>
              </div>
              <div class="cost-col cost-col--car">
                <div class="cost-col__title">Car (9.0 L/100km)</div>
                <div class="cost-line"><span class="cost-line__label">Fuel</span><span class="cost-line__val" id="co-car-fuel">—</span></div>
                <div class="cost-line"><span class="cost-line__label">Tyres</span><span class="cost-line__val" id="co-car-tyres">—</span></div>
                <div class="cost-line"><span class="cost-line__label">Oil / Service</span><span class="cost-line__val" id="co-car-oil">—</span></div>
                <div class="cost-total"><span>Annual Total</span><span class="cost-total__val" id="co-car-total">—</span></div>
              </div>
            </div>
            <div class="saving-banner">
              <div>
                <div class="saving-banner__label">Annual Saving vs Car</div>
                <div class="payback-note" id="co-payback"></div>
              </div>
              <div class="saving-banner__val" id="co-saving">—</div>
            </div>
          </div>

        </div>

        <div class="tool-seo">
          <h2>The True Cost of Motorcycle Commuting</h2>
          <p>Motorcycles are significantly cheaper to run than cars, but the full picture includes more than just fuel. Tyres wear faster under hard use, oil changes are more frequent per kilometre, and consumables add up over a year. This calculator combines all three major running costs into a realistic annual figure you can compare directly against car ownership.</p>
          <h2>How Costs Are Estimated</h2>
          <p>Fuel cost is calculated from your weekly distance, consumption figure, and fuel price. Tyre cost is based on typical replacement intervals by engine size: smaller bikes wear tyres more slowly, while large-displacement machines need replacement more often. Oil and servicing is estimated at one change per 5,000 km at £35 per service.</p>
          <h2>Car Comparison Assumptions</h2>
          <p>The car comparison uses a fixed consumption of 9.0 L/100km — a reasonable average for a medium family car. Car tyres are estimated at £280 per set every 30,000 km, with oil at £60 per 10,000 km. Adjust your inputs to reflect your actual car if you want a more precise comparison.</p>
        </div>
      </div>
      <aside class="tool-sidebar"><div class="ad-slot"><!-- AdSense 160×600 --></div></aside>
    </div>
  </div>
</div>

<script>
(function () {
  function fuelEstimateForCC(cc) {
    if (cc < 250) return 3.5;
    if (cc < 500) return 4.5;
    if (cc < 750) return 5.5;
    if (cc < 1000) return 6.5;
    return 7.5;
  }

  function tyreDataForCC(cc) {
    if (cc < 500) return { cost: 120, interval: 8000 };
    if (cc <= 1000) return { cost: 180, interval: 6000 };
    return { cost: 240, interval: 5000 };
  }

  BikeFinder.init('bike-finder-co', function (spec) {
    var container = document.getElementById('bike-finder-co');
    var notes = [];

    if (spec.displacement) {
      var ccMatch = spec.displacement.match(/(\d+)\s*cc/i);
      if (!ccMatch) ccMatch = spec.displacement.match(/(\d+)/);
      if (ccMatch) {
        var cc = parseInt(ccMatch[1]);
        document.getElementById('co-engine-cc').value = cc;
        var est = fuelEstimateForCC(cc);
        document.getElementById('co-fuel-use').value = est;
        notes.push(cc + 'cc detected. Fuel estimate set to ' + est + ' L/100km.');
      }
    } else {
      notes.push('Displacement not in API — enter engine size manually.');
    }

    showLookupStatus(container, (spec.make || '') + ' ' + (spec.model || '') + ' ' + (spec.year || '') + ' — ' + notes.join(' '), 'success');
  });

  window.coUpdateFuelEstimate = function () {
    var cc = parseFloat(document.getElementById('co-engine-cc').value);
    if (!isNaN(cc) && cc > 0) {
      document.getElementById('co-fuel-use').value = fuelEstimateForCC(cc);
    }
  };

  function fmt(val) {
    return '£' + val.toFixed(2);
  }

  window.coCalculate = function () {
    var cc = parseFloat(document.getElementById('co-engine-cc').value);
    var bikeFuel = parseFloat(document.getElementById('co-fuel-use').value);
    var weeklyKm = parseFloat(document.getElementById('co-weekly-km').value);
    var fuelPrice = parseFloat(document.getElementById('co-fuel-price').value);
    var weeks = parseFloat(document.getElementById('co-weeks').value);
    var purchasePrice = parseFloat(document.getElementById('co-purchase').value) || 0;

    if (!cc || !bikeFuel || !weeklyKm || !fuelPrice || !weeks) {
      alert('Please fill in all required fields.');
      return;
    }

    var annualKm = weeklyKm * weeks;

    // Motorcycle costs
    var bikeFuelCost = (annualKm / 100) * bikeFuel * fuelPrice;
    var tyreData = tyreDataForCC(cc);
    var bikeTyreCost = (annualKm / tyreData.interval) * tyreData.cost;
    var bikeOilCost = (annualKm / 5000) * 35;
    var bikeTotal = bikeFuelCost + bikeTyreCost + bikeOilCost;

    // Car costs (fixed 9 L/100km, tyres £280/30000km, oil £60/10000km)
    var carFuelCost = (annualKm / 100) * 9.0 * fuelPrice;
    var carTyreCost = (annualKm / 30000) * 280;
    var carOilCost = (annualKm / 10000) * 60;
    var carTotal = carFuelCost + carTyreCost + carOilCost;

    var saving = carTotal - bikeTotal;

    document.getElementById('co-bike-fuel').textContent = fmt(bikeFuelCost);
    document.getElementById('co-bike-tyres').textContent = fmt(bikeTyreCost);
    document.getElementById('co-bike-oil').textContent = fmt(bikeOilCost);
    document.getElementById('co-bike-total').textContent = fmt(bikeTotal);

    document.getElementById('co-car-fuel').textContent = fmt(carFuelCost);
    document.getElementById('co-car-tyres').textContent = fmt(carTyreCost);
    document.getElementById('co-car-oil').textContent = fmt(carOilCost);
    document.getElementById('co-car-total').textContent = fmt(carTotal);

    document.getElementById('co-saving').textContent = (saving >= 0 ? '+' : '') + fmt(saving);

    var paybackEl = document.getElementById('co-payback');
    if (purchasePrice > 0 && saving > 0) {
      var paybackYears = (purchasePrice / saving).toFixed(1);
      paybackEl.textContent = 'Purchase price £' + purchasePrice.toLocaleString() + ' paid back in approx. ' + paybackYears + ' year' + (paybackYears === '1.0' ? '' : 's') + ' of commuting savings.';
    } else {
      paybackEl.textContent = 'Enter a purchase price above to calculate payback period.';
    }

    var resultsEl = document.getElementById('co-results');
    resultsEl.style.display = '';
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
}());
</script>
