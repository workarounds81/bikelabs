<script>
(function () {
  var inseamCm = document.getElementById('inseam-cm');
  var inseamIn = document.getElementById('inseam-in');
  var seatHeight = document.getElementById('seat-height');

  // Sync inseam cm <-> inches
  inseamCm.addEventListener('input', function () {
    inseamIn.value = (parseFloat(this.value) / 2.54).toFixed(1);
    autoCalc();
  });
  inseamIn.addEventListener('input', function () {
    inseamCm.value = (parseFloat(this.value) * 2.54).toFixed(1);
    autoCalc();
  });
  seatHeight.addEventListener('input', autoCalc);
  document.getElementById('rider-height').addEventListener('input', autoCalc);

  function autoCalc() {
    if (seatHeight.value && inseamCm.value) calculateFitment();
  }

  BikeFinder.init('bike-finder-erg', function (spec) {
    var container = document.getElementById('bike-finder-erg');
    var filled = [];

    if (spec.seat_height) {
      // Parse mm or cm from string like "820 mm" or "82 cm" or "820"
      var raw = String(spec.seat_height).trim();
      var numMatch = raw.match(/([\d.]+)\s*(mm|cm)?/i);
      if (numMatch) {
        var val = parseFloat(numMatch[1]);
        var unit = (numMatch[2] || '').toLowerCase();
        if (unit === 'cm' || val < 200) val = val * 10; // convert cm to mm
        seatHeight.value = Math.round(val);
        filled.push('seat height');
        autoCalc();
      }
    }

    showLookupStatus(container,
      filled.length
        ? 'Pre-filled: ' + filled.join(', ') + '. Adjust if needed.'
        : 'Spec loaded — seat height not available for this model.',
      filled.length ? 'success' : 'warn');
  });

  window.calculateFitment = function () {
    var seatMM = parseFloat(seatHeight.value);
    var inseamMM = parseFloat(inseamCm.value) * 10;
    if (isNaN(seatMM) || isNaN(inseamMM)) return;

    var gapMM = seatMM - inseamMM;
    var gapIn = gapMM / 25.4;

    var label, desc, colorClass, barColorClass, score;

    if (gapMM <= 0) {
      label = 'Flat-Foot Comfortable';
      desc = 'Both feet flat on the ground. Ideal for new riders and city commuting.';
      colorClass = 'fitment-badge--green';
      barColorClass = 'comfort-bar-fill--green';
      score = 100;
    } else if (gapMM <= 50) {
      label = 'Ball-of-Foot Contact';
      desc = 'Manageable for most riders. Good balance between reach and ground feel.';
      colorClass = 'fitment-badge--orange';
      barColorClass = 'comfort-bar-fill--orange';
      score = Math.round(80 - (gapMM / 50) * 30);
    } else if (gapMM <= 75) {
      label = 'Split-Heel / Tiptoe';
      desc = 'Requires confident low-speed handling. Consider suspension lowering.';
      colorClass = 'fitment-badge--orange';
      barColorClass = 'comfort-bar-fill--orange';
      score = Math.round(50 - ((gapMM - 50) / 25) * 20);
    } else {
      label = 'High-Risk Tiptoe';
      desc = 'Significant reach shortfall. Suspension lowering or a different model strongly recommended.';
      colorClass = 'fitment-badge--red';
      barColorClass = 'comfort-bar-fill--red';
      score = Math.max(5, Math.round(30 - ((gapMM - 75) / 50) * 25));
    }

    score = Math.max(5, Math.min(100, score));

    var gapDisplay = gapMM <= 0
      ? Math.abs(gapMM).toFixed(0) + ' mm surplus'
      : gapMM.toFixed(0) + ' mm shortfall';
    var gapInDisplay = gapMM <= 0
      ? (Math.abs(gapIn)).toFixed(1) + '" surplus'
      : gapIn.toFixed(1) + '" shortfall';

    document.getElementById('erg-results-content').innerHTML =
      '<span class="fitment-badge ' + colorClass + '">' + label + '</span>'
      + '<p class="fitment-desc">' + desc + '</p>'
      + '<div class="fitment-gap-row">'
      + '<div class="fitment-gap-item"><span class="label">Seat Height</span><span class="value">' + seatMM.toFixed(0) + ' mm</span></div>'
      + '<div class="fitment-gap-item"><span class="label">Inseam</span><span class="value">' + (inseamMM).toFixed(0) + ' mm</span></div>'
      + '<div class="fitment-gap-item"><span class="label">Reach Gap</span><span class="value">' + gapDisplay + '</span></div>'
      + '<div class="fitment-gap-item"><span class="label">In Inches</span><span class="value">' + gapInDisplay + '</span></div>'
      + '</div>'
      + '<div class="comfort-bar-wrap">'
      + '<div class="bar-label">Comfort Score — ' + score + ' / 100</div>'
      + '<div class="comfort-bar-track"><div class="comfort-bar-fill ' + barColorClass + '" style="width:' + score + '%"></div></div>'
      + '</div>';

    var resultsEl = document.getElementById('erg-results');
    resultsEl.style.display = '';
  };
}());
</script>
