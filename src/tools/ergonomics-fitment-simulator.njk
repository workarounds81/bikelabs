<div class="tool-page">
  <div>
    <h1>Ergonomics &amp; Fitment Simulator</h1>
    <p class="tool-intro" style="text-align:center">Enter your rider measurements and a bike's seat height to find out how well it fits — before you sit on it.</p>
    <div class="tool-layout">
      <aside class="tool-sidebar"><div class="ad-slot"><!-- AdSense 160×600 --></div></aside>
      <div class="tool-main">
        <div class="tool-card">

          <h2>Find Your Bike</h2>
          <div id="bike-finder-erg" class="api-lookup-block"></div>

          <h2>Bike Dimensions</h2>
          <div class="selector-row">
            <div class="form-group">
              <label for="erg-seat-height">Seat Height (mm)</label>
              <input type="number" id="erg-seat-height" value="820" min="600" max="1100" step="1" oninput="ergAutoCalc()">
            </div>
          </div>

          <h2>Rider Measurements</h2>
          <div class="selector-row">
            <div class="form-group">
              <label for="erg-inseam-cm">Inseam (cm)</label>
              <input type="number" id="erg-inseam-cm" value="82" min="50" max="120" step="0.5" oninput="ergSyncInseam('cm')">
            </div>
            <div class="form-group">
              <label for="erg-inseam-in">Inseam (inches)</label>
              <input type="number" id="erg-inseam-in" value="32.3" min="20" max="48" step="0.1" oninput="ergSyncInseam('in')">
            </div>
            <div class="form-group">
              <label for="erg-height-cm">Rider Height (cm)</label>
              <input type="number" id="erg-height-cm" value="178" min="140" max="220" step="1" oninput="ergAutoCalc()">
            </div>
          </div>

          <button class="btn-calculate" onclick="ergCalculate()">Check Fitment</button>

          <div class="results" id="erg-results" style="display:none">
            <div id="erg-result-card" class="fitment-result">
              <div class="fitment-result__label" id="erg-classification"></div>
              <div class="fitment-result__details" id="erg-details"></div>
              <div class="comfort-bar-wrap">
                <div class="comfort-bar-track"><div class="comfort-bar-fill" id="erg-bar" style="width:0%"></div></div>
                <div class="comfort-bar-label" id="erg-bar-label"></div>
              </div>
              <div class="gap-stats">
                <div class="gap-stat">
                  <div class="gap-stat__val" id="erg-gap-mm">—</div>
                  <span class="gap-stat__unit">gap (mm)</span>
                </div>
                <div class="gap-stat">
                  <div class="gap-stat__val" id="erg-gap-in">—</div>
                  <span class="gap-stat__unit">gap (inches)</span>
                </div>
              </div>
            </div>
          </div>

        </div>

        <div class="tool-seo">
          <h2>How Seat Height Affects Fitment</h2>
          <p>Seat height is one of the most important factors when choosing a motorcycle, yet it's rarely the whole story. A rider's inseam length determines how much of their foot reaches the ground. The "gap" — the difference between seat height and inseam (converted to mm) — tells you whether you'll be flat-footed, on the balls of your feet, or tiptoe-ing at a stop.</p>
          <h2>Understanding the Classifications</h2>
          <p>Flat-Foot Comfortable means both feet rest completely on the ground with knees slightly bent — ideal for new riders and urban commuters. Ball-of-Foot Contact is the most common scenario for experienced riders: only the front of the foot touches down, but control is maintained easily. Split-Heel or Tiptoe situations require more care at slow speed and in car parks. High-Risk Tiptoe means only one foot can reach the ground comfortably — this is manageable for experienced riders but can be dangerous for beginners.</p>
          <h2>Seat Height vs Inseam: Not Always a Dealbreaker</h2>
          <p>A tall bike doesn't automatically mean a bad fit. Suspension sag, lowering links, seat shaping options, and boot heel height all affect real-world reach. Use this tool as a starting guide, not the final word — always sit on a bike before buying.</p>
        </div>
      </div>
      <aside class="tool-sidebar"><div class="ad-slot"><!-- AdSense 160×600 --></div></aside>
    </div>
  </div>
</div>

<script>
(function () {
  BikeFinder.init('bike-finder-erg', function (spec) {
    var container = document.getElementById('bike-finder-erg');
    var notes = [];

    if (spec.seat_height) {
      var raw = spec.seat_height;
      var mmMatch = raw.match(/(\d{3,4})\s*mm/i);
      var cmMatch = raw.match(/([\d.]+)\s*cm/i);
      var inMatch = raw.match(/([\d.]+)\s*in/i);
      var seatMM = null;

      if (mmMatch) {
        seatMM = parseFloat(mmMatch[1]);
      } else if (cmMatch) {
        seatMM = parseFloat(cmMatch[1]) * 10;
      } else if (inMatch) {
        seatMM = parseFloat(inMatch[1]) * 25.4;
      } else {
        // bare number — if > 200 assume mm, else assume cm
        var bare = parseFloat(raw);
        if (!isNaN(bare)) seatMM = bare > 200 ? bare : bare * 10;
      }

      if (seatMM !== null) {
        document.getElementById('erg-seat-height').value = Math.round(seatMM);
        notes.push('Seat height ' + Math.round(seatMM) + ' mm applied.');
      } else {
        notes.push('Seat height format unrecognised — enter manually.');
      }
    } else {
      notes.push('Seat height not in API data — enter manually.');
    }

    showLookupStatus(container, (spec.make || '') + ' ' + (spec.model || '') + ' ' + (spec.year || '') + ' — ' + notes.join(' '), 'success');
    ergAutoCalc();
  });

  window.ergSyncInseam = function (source) {
    if (source === 'cm') {
      var cm = parseFloat(document.getElementById('erg-inseam-cm').value);
      if (!isNaN(cm)) document.getElementById('erg-inseam-in').value = (cm / 2.54).toFixed(1);
    } else {
      var inches = parseFloat(document.getElementById('erg-inseam-in').value);
      if (!isNaN(inches)) document.getElementById('erg-inseam-cm').value = (inches * 2.54).toFixed(1);
    }
    ergAutoCalc();
  };

  window.ergAutoCalc = function () {
    var seat = parseFloat(document.getElementById('erg-seat-height').value);
    var inseam = parseFloat(document.getElementById('erg-inseam-cm').value);
    if (!isNaN(seat) && !isNaN(inseam) && seat > 0 && inseam > 0) {
      ergCalculate();
    }
  };

  window.ergCalculate = function () {
    var seatMM = parseFloat(document.getElementById('erg-seat-height').value);
    var inseamCM = parseFloat(document.getElementById('erg-inseam-cm').value);

    if (isNaN(seatMM) || isNaN(inseamCM) || seatMM <= 0 || inseamCM <= 0) {
      alert('Please enter seat height and inseam.');
      return;
    }

    var gapMM = seatMM - (inseamCM * 10);
    var gapIn = (gapMM / 25.4).toFixed(1);

    var classification, theme, details, scorePercent;

    if (gapMM <= 0) {
      classification = 'Flat-Foot Comfortable';
      theme = 'green';
      details = 'Both feet rest flat on the ground with room to spare. Ideal for new riders, urban commuting, and stop-start traffic.';
      scorePercent = 100;
    } else if (gapMM <= 50) {
      classification = 'Ball-of-Foot Contact';
      theme = 'orange';
      details = 'The front portion of both feet reaches the ground. Comfortable for most experienced riders — very manageable in traffic.';
      scorePercent = 75;
    } else if (gapMM <= 75) {
      classification = 'Split-Heel / Tiptoe';
      theme = 'orange';
      details = 'Only one foot reaches down comfortably, or both feet are on tiptoe. Requires more care at low speed and in car parks.';
      scorePercent = 45;
    } else {
      classification = 'High-Risk Tiptoe';
      theme = 'red';
      details = 'Significant reach gap. Not recommended for less experienced riders. Consider seat lowering options, lowering links, or a different model.';
      scorePercent = 15;
    }

    var card = document.getElementById('erg-result-card');
    card.className = 'fitment-result fitment-result--' + theme;

    document.getElementById('erg-classification').textContent = classification;
    document.getElementById('erg-details').textContent = details;

    var bar = document.getElementById('erg-bar');
    bar.className = 'comfort-bar-fill comfort-bar-fill--' + theme;
    bar.style.width = scorePercent + '%';
    document.getElementById('erg-bar-label').textContent = 'Comfort score: ' + scorePercent + '%';

    document.getElementById('erg-gap-mm').textContent = (gapMM >= 0 ? '+' : '') + Math.round(gapMM);
    document.getElementById('erg-gap-in').textContent = (parseFloat(gapIn) >= 0 ? '+' : '') + gapIn;

    var resultsEl = document.getElementById('erg-results');
    resultsEl.style.display = '';
  };
}());
</script>
