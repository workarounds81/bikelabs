<script>
BikeFinder.init('bike-finder-fuel', function(spec) {
  var container=document.getElementById('bike-finder-fuel');
  var unit=document.getElementById('api-fuel-unit').value;
  if(!spec.fuel_capacity){showLookupStatus(container,'Technical specifications incomplete — fuel capacity data missing. Please input manually.','warn');return;}
  var raw=spec.fuel_capacity;
  var litreMatch=raw.match(/([\d.]+)\s*litr/i);
  var gallonMatch=raw.match(/([\d.]+)\s*(?:US\s+)?gall/i);
  var tankVal=null,usedUnit='';
  if(unit==='litres'&&litreMatch){tankVal=parseFloat(litreMatch[1]);usedUnit='L';}
  else if(unit==='gallons'&&gallonMatch){tankVal=parseFloat(gallonMatch[1]);usedUnit='US gal';}
  else if(litreMatch){tankVal=parseFloat(litreMatch[1]);usedUnit='L';}
  else if(gallonMatch){tankVal=parseFloat(gallonMatch[1]);usedUnit='US gal';}
  if(!tankVal){showLookupStatus(container,'Could not parse "'+raw+'". Please input manually.','warn');return;}
  var tankL=usedUnit==='US gal'?tankVal*3.78541:tankVal;
  document.getElementById('tank').value=tankL.toFixed(2);
  showLookupStatus(container,(spec.make||'')+' '+(spec.model||'')+' '+(spec.year||'')+' — Tank '+tankVal.toFixed(2)+' '+usedUnit+' ('+tankL.toFixed(2)+' L) loaded. Enter your consumption to calculate range.','success');
});

function calcFuel(){
  var tank=+document.getElementById('tank').value;
  var res=+document.getElementById('reserve').value;
  var cons=+document.getElementById('cons').value;
  var full=tank/cons*100,toRes=(tank-res)/cons*100,onRes=res/cons*100;
  document.getElementById('r-full-km').textContent=full.toFixed(0)+' km';
  document.getElementById('r-full-mi').textContent=(full*.621).toFixed(0)+' miles';
  document.getElementById('r-res-km').textContent=toRes.toFixed(0)+' km';
  document.getElementById('r-res-mi').textContent=(toRes*.621).toFixed(0)+' miles';
  document.getElementById('r-only-km').textContent=onRes.toFixed(0)+' km';
  document.getElementById('r-only-mi').textContent=(onRes*.621).toFixed(0)+' miles';
  document.getElementById('results').style.display='block';
}
</script>
