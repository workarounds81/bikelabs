<script>
(function () {
  function setSelectByValue(id, value) {
    var el = document.getElementById(id);
    if (!el) return;
    for (var i = 0; i < el.options.length; i++) {
      if (el.options[i].value === String(value)) { el.selectedIndex = i; return; }
    }
  }

  var gearCountSel = document.getElementById('gear-count');
  var manualSection = document.getElementById('manual-gearbox-section');
  var cvtNotice = document.getElementById('cvt-notice');
  var calcBtn = document.getElementById('calc-btn');
  var gearRatioSection = document.getElementById('gear-ratio-section');

  function isCVT() { return gearCountSel.value === 'cvt'; }

  function updateGearRows() {
    var cvt = isCVT();
    cvtNotice.style.display = cvt ? '' : 'none';
    manualSection.style.display = cvt ? 'none' : '';
    gearRatioSection.style.display = cvt ? 'none' : '';
    calcBtn.style.display = cvt ? 'none' : '';
    if (!cvt) {
      var count = parseInt(gearCountSel.value);
      document.querySelectorAll('.gear-row').forEach(function (row) {
        var gear = parseInt(row.dataset.gear);
        row.style.display = gear <= count ? '' : 'none';
      });
    }
  }

  gearCountSel.addEventListener('change', updateGearRows);
  updateGearRows();

  BikeFinder.init('bike-finder-ts', function (spec) {
    var container = document.getElementById('bike-finder-ts');
    var filled = [];

    var tx = spec.transmission || '';
    var isCvt = /cvt|automatic|auto|scooter/i.test(tx) && !/\d-speed/i.test(tx);
    if (isCvt) {
      setSelectByValue('gear-count', 'cvt');
      updateGearRows();
      var tsVal = spec.top_speed || null;
      if (tsVal) {
        document.getElementById('cvt-notice').innerHTML =
          'ℹ️ <strong>Automatic / CVT transmission</strong> — gear ratio calculation does not apply.'
          + '<br><span style="color:#86efac;font-size:1.05em;font-weight:700;">Manufacturer top speed: ' + tsVal + '</span>';
        showLookupStatus(container, (spec.make||'')+' '+(spec.model||'')+' — CVT detected. Manufacturer top speed: ' + tsVal, 'success');
      } else {
        showLookupStatus(container, (spec.make||'')+' '+(spec.model||'')+' — Automatic/CVT detected. No top speed data available in the spec database for this model.', 'warn');
      }
      return;
    }

    var txMatch = tx.match(/(\d)-speed/i);
    if (txMatch) {
      setSelectByValue('gear-count', txMatch[1]);
      updateGearRows();
      filled.push('gear count');
    }

    if (spec.rear_tire) {
      var t = parseTyreCode(spec.rear_tire);
      if (t) {
        setSelectByValue('tyre-width', String(t.width));
        setSelectByValue('tyre-aspect', String(t.aspect));
        setSelectByValue('tyre-rim', String(t.rim));
        filled.push('rear tyre');
      }
    }

    showLookupStatus(container,
      filled.length
        ? 'Pre-filled: ' + filled.join(', ') + '. Adjust values as needed.'
        : 'Spec found but no tyre or transmission data available.',
      filled.length ? 'success' : 'warn');
  });

  window.calculateTopSpeed = function () {
    var rpm = parseFloat(document.getElementById('redline-rpm').value);
    var primary = parseFloat(document.getElementById('primary-ratio').value);
    var frontT = parseFloat(document.getElementById('front-sprocket').value);
    var rearT = parseFloat(document.getElementById('rear-sprocket').value);
    var width = parseFloat(document.getElementById('tyre-width').value);
    var aspect = parseFloat(document.getElementById('tyre-aspect').value);
    var rim = parseFloat(document.getElementById('tyre-rim').value);
    var finalDrive = rearT / frontT;

    var sidewallMM = width * (aspect / 100);
    var diameterM = (sidewallMM * 2 + rim * 25.4) / 1000;

    var gearCount = parseInt(document.getElementById('gear-count').value);
    var ratioInputs = Array.from(document.querySelectorAll('.gear-ratio-input'));

    var speeds = [];
    var maxSpeed = 0;
    var maxGear = 1;

    for (var g = 0; g < gearCount; g++) {
      var ratio = parseFloat(ratioInputs[g].value);
      var speedKmh = (rpm * Math.PI * diameterM * 60) / (ratio * primary * finalDrive * 1000);
      var speedMph = speedKmh * 0.621371;
      speeds.push({ gear: g + 1, ratio: ratio, speedKmh: speedKmh, speedMph: speedMph });
      if (speedKmh > maxSpeed) { maxSpeed = speedKmh; maxGear = g + 1; }
    }

    var rows = speeds.map(function (s) {
      var isTop = s.gear === maxGear;
      return '<tr' + (isTop ? ' class="top-speed-row"' : '') + '>'
        + '<td>Gear ' + s.gear + (isTop ? ' ★' : '') + '</td>'
        + '<td>' + s.ratio.toFixed(3) + '</td>'
        + '<td>' + s.speedKmh.toFixed(1) + '</td>'
        + '<td>' + s.speedMph.toFixed(1) + '</td>'
        + '</tr>';
    }).join('');

    document.getElementById('ts-results-content').innerHTML =
      '<div class="ts-summary">'
      + '<div class="ts-summary-item"><span class="label">Max Speed</span><span class="value">' + maxSpeed.toFixed(0) + ' km/h</span></div>'
      + '<div class="ts-summary-item"><span class="label">In mph</span><span class="value">' + (maxSpeed * 0.621371).toFixed(0) + ' mph</span></div>'
      + '<div class="ts-summary-item"><span class="label">Final Drive Ratio</span><span class="value">' + finalDrive.toFixed(3) + '</span></div>'
      + '<div class="ts-summary-item"><span class="label">Tyre Diameter</span><span class="value">' + (diameterM * 1000).toFixed(0) + ' mm</span></div>'
      + '</div>'
      + '<table class="speed-table">'
      + '<thead><tr><th>Gear</th><th>Gear Ratio</th><th>Speed (km/h)</th><th>Speed (mph)</th></tr></thead>'
      + '<tbody>' + rows + '</tbody>'
      + '</table>';

    var resultsEl = document.getElementById('ts-results');
    resultsEl.style.display = '';
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
}());
</script>
