              </div>
            </div>
            <div class="selector-row gear-row" data-gear="5">
              <div class="form-group">
                <label>Gear 5 Ratio</label>
                <input type="number" class="gear-ratio-input" value="1.190" step="0.001" min="0.5" max="6">
              </div>
            </div>
            <div class="selector-row gear-row" data-gear="6">
              <div class="form-group">
                <label>Gear 6 Ratio</label>
