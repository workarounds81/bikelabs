<script>
(function(){
  var bikes=window.BIKES||[];
  var makes=[...new Set(bikes.map(b=>b.make))].sort();
  var ms=document.getElementById('make-select'),mo=document.getElementById('model-select');
  makes.forEach(function(m){var o=document.createElement('option');o.value=m;o.textContent=m;ms.appendChild(o);});
  ms.addEventListener('change',function(){
    mo.innerHTML='<option value="">-- Select Model --</option>';mo.disabled=true;
    if(!this.value)return;
    bikes.filter(b=>b.make===this.value).forEach(function(b){
      var o=document.createElement('option');o.value=b.model;o.textContent=b.model+' ('+b.year+')';
      o.dataset.front=b.front_sprocket;o.dataset.rear=b.rear_sprocket;o.dataset.tyre=b.rear_tyre||'';
      mo.appendChild(o);
    });
    mo.disabled=false;
  });
  mo.addEventListener('change',function(){
    var s=this.options[this.selectedIndex];
    if(s.dataset.front){document.getElementById('front-sprocket').value=s.dataset.front;}
    if(s.dataset.rear){document.getElementById('rear-sprocket').value=s.dataset.rear;}
    if(s.dataset.tyre){
      var m=s.dataset.tyre.match(/^(\d+)\/(\d+)ZR(\d+)|^(\d+)\/(\d+)R(\d+)|^(\d+)\/(\d+)-(\d+)/);
      if(m){
        var w=m[1]||m[4]||m[7],a=m[2]||m[5]||m[8],r=m[3]||m[6]||m[9];
        if(w){
          var wSel=document.getElementById('tire-width');
          for(var i=0;i<wSel.options.length;i++){if(wSel.options[i].value==w){wSel.selectedIndex=i;break;}}
        }
        if(a){
          var aSel=document.getElementById('aspect-ratio');
          for(var i=0;i<aSel.options.length;i++){if(aSel.options[i].value==a){aSel.selectedIndex=i;break;}}
        }
        if(r){
          var rSel=document.getElementById('wheel-size');
          for(var i=0;i<rSel.options.length;i++){if(rSel.options[i].value==r){rSel.selectedIndex=i;break;}}
        }
      }
    }
  });
})();

(function() {
  // Show/hide gear rows based on selected gear count
  const gearCountEl = document.getElementById('gear-count');

  function updateGearRows() {
    const count = parseInt(gearCountEl.value, 10);
    document.querySelectorAll('.gear-row').forEach(function(row) {
      const gear = parseInt(row.getAttribute('data-gear'), 10);
      row.style.display = gear <= count ? '' : 'none';
    });
  }

  gearCountEl.addEventListener('change', updateGearRows);
  updateGearRows();

  window.calculate = function() {
    const frontTeeth = parseFloat(document.getElementById('front-sprocket').value);
    const rearTeeth = parseFloat(document.getElementById('rear-sprocket').value);
    const tireWidth = parseFloat(document.getElementById('tire-width').value);
    const aspectRatio = parseFloat(document.getElementById('aspect-ratio').value);
    const wheelSizeIn = parseFloat(document.getElementById('wheel-size').value);
    const maxRPM = parseFloat(document.getElementById('max-rpm').value);
    const gearCount = parseInt(document.getElementById('gear-count').value, 10);

    if (!frontTeeth || !rearTeeth || !tireWidth || !aspectRatio || !wheelSizeIn || !maxRPM) {
      alert('Please fill in all fields.');
      return;
    }

    // Tyre diameter in mm
    const tireDiameterMm = (tireWidth * aspectRatio / 100 * 2) + (wheelSizeIn * 25.4);
    // Tyre circumference in metres
    const tireCircumferenceM = Math.PI * tireDiameterMm / 1000;

    // Overall final drive ratio
    const overallRatio = rearTeeth / frontTeeth;

    function calcSpeed(rpm, gearRatio, overall) {
      // km/h
      return (rpm * tireCircumferenceM * 60) / (gearRatio * overall * 1000);
    }

    // Build results table
    const tbody = document.getElementById('results-tbody');
    tbody.innerHTML = '';

    for (let g = 1; g <= gearCount; g++) {
      const gr = parseFloat(document.getElementById('gr-' + g).value);
      const speedKmh = calcSpeed(maxRPM, gr, overallRatio);
      const speedMph = speedKmh * 0.621371;
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>Gear ' + g + '</td>' +
        '<td>' + gr.toFixed(3) + '</td>' +
        '<td>' + speedKmh.toFixed(1) + '</td>' +
        '<td>' + speedMph.toFixed(1) + '</td>';
      tbody.appendChild(tr);
    }

    // Top speed is last (highest) gear
    const topGearRatio = parseFloat(document.getElementById('gr-' + gearCount).value);
    const topSpeedKmh = calcSpeed(maxRPM, topGearRatio, overallRatio);
    const topSpeedMph = topSpeedKmh * 0.621371;

    // Summary
    document.getElementById('result-summary').innerHTML =
      '<strong>Overall Drive Ratio:</strong> ' + overallRatio.toFixed(3) +
      ' &nbsp;|&nbsp; <strong>Estimated Top Speed:</strong> ' +
      topSpeedKmh.toFixed(1) + ' km/h (' + topSpeedMph.toFixed(1) + ' mph) at ' +
      maxRPM.toLocaleString() + ' RPM in top gear';

    // Sprocket swap preview
    const swapTbody = document.getElementById('swap-tbody');
    swapTbody.innerHTML = '';

    const swaps = [
      { label: 'Front +1 (' + (frontTeeth + 1) + 'T)', front: frontTeeth + 1, rear: rearTeeth },
      { label: 'Front -1 (' + (frontTeeth - 1) + 'T)', front: frontTeeth - 1, rear: rearTeeth },
      { label: 'Rear +1 (' + (rearTeeth + 1) + 'T)', front: frontTeeth, rear: rearTeeth + 1 },
      { label: 'Rear -1 (' + (rearTeeth - 1) + 'T)', front: frontTeeth, rear: rearTeeth - 1 },
    ];

    swaps.forEach(function(s) {
      if (s.front < 1 || s.rear < 1) return;
      const swapOverall = s.rear / s.front;
      const swapTopKmh = calcSpeed(maxRPM, topGearRatio, swapOverall);
      const swapTopMph = swapTopKmh * 0.621371;
      const diffKmh = swapTopKmh - topSpeedKmh;
      const diffClass = diffKmh >= 0 ? 'delta-pos' : 'delta-neg';
      const diffStr = (diffKmh >= 0 ? '+' : '') + diffKmh.toFixed(1) + ' km/h';
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + s.label + '</td>' +
        '<td>' + swapOverall.toFixed(3) + '</td>' +
        '<td>' + swapTopKmh.toFixed(1) + '</td>' +
        '<td>' + swapTopMph.toFixed(1) + '</td>' +
        '<td class="' + diffClass + '">' + diffStr + '</td>';
      swapTbody.appendChild(tr);
    });

    document.getElementById('calc-results').style.display = '';
    document.getElementById('calc-results').scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
})();
</script>
