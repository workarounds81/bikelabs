<script>
function setSelectByValue(id,val){
  var el=document.getElementById(id);
  for(var i=0;i<el.options.length;i++){if(el.options[i].value==val){el.selectedIndex=i;return;}}
}

BikeFinder.init('bike-finder-gr', function(spec) {
  var container=document.getElementById('bike-finder-gr');
  var notes=[];
  if(spec.transmission){
    var tx=spec.transmission;
    var gearMatch=tx.match(/(\d)\s*[-\s]?\s*[Ss]peed/);
    if(gearMatch){
      var gc=parseInt(gearMatch[1]);
      var gcSel=document.getElementById('gear-count');
      for(var i=0;i<gcSel.options.length;i++){if(parseInt(gcSel.options[i].value)===gc){gcSel.selectedIndex=i;break;}}
      gcSel.dispatchEvent(new Event('change'));
      notes.push(gc+'-speed gearbox detected.');
    }
    var drive=tx.match(/chain|belt|shaft/i);
    notes.push(drive?'Drive: '+drive[0]+'.':'Drive type not listed — verify manually.');
  } else {
    notes.push('Transmission data missing — enter gear count manually.');
  }
  if(spec.rear_tire){
    var t=parseTyreCode(spec.rear_tire);
    if(t){setSelectByValue('tire-width',t.width);setSelectByValue('aspect-ratio',t.aspect);setSelectByValue('wheel-size',t.rim);notes.push('Rear tyre '+spec.rear_tire+' applied.');}
  }
  notes.push('Sprocket counts not in API — enter manually.');
  showLookupStatus(container,(spec.make||'')+' '+(spec.model||'')+' '+(spec.year||'')+' — '+notes.join(' '),'success');
});

(function(){
  var gc=document.getElementById('gear-count');
  function update(){var c=parseInt(gc.value);document.querySelectorAll('.gear-row').forEach(function(r){r.style.display=parseInt(r.getAttribute('data-gear'))<=c?'':'none';});}
  gc.addEventListener('change',update);update();
})();

window.calculate=function(){
  var f=parseFloat(document.getElementById('front-sprocket').value);
  var r=parseFloat(document.getElementById('rear-sprocket').value);
  var tw=parseFloat(document.getElementById('tire-width').value);
  var ar=parseFloat(document.getElementById('aspect-ratio').value);
  var ws=parseFloat(document.getElementById('wheel-size').value);
  var rpm=parseFloat(document.getElementById('max-rpm').value);
  var gc=parseInt(document.getElementById('gear-count').value);
  if(!f||!r||!tw||!ar||!ws||!rpm){alert('Please fill in all fields.');return;}
  var circ=Math.PI*((tw*ar/100*2)+(ws*25.4))/1000;
  var overall=r/f;
  function spd(rpm,gr,ov){return rpm*circ*60/(gr*ov*1000);}
  var tbody=document.getElementById('results-tbody');tbody.innerHTML='';
  for(var g=1;g<=gc;g++){
    var gr=parseFloat(document.getElementById('gr-'+g).value);
    var k=spd(rpm,gr,overall);
    var tr=document.createElement('tr');
    tr.innerHTML='<td>Gear '+g+'</td><td>'+gr.toFixed(3)+'</td><td>'+k.toFixed(1)+'</td><td>'+(k*.621371).toFixed(1)+'</td>';
    tbody.appendChild(tr);
  }
  var topGR=parseFloat(document.getElementById('gr-'+gc).value);
  var topK=spd(rpm,topGR,overall);
  document.getElementById('result-summary').innerHTML='<strong>Overall Drive Ratio:</strong> '+overall.toFixed(3)+' &nbsp;|&nbsp; <strong>Estimated Top Speed:</strong> '+topK.toFixed(1)+' km/h ('+(topK*.621371).toFixed(1)+' mph) at '+rpm.toLocaleString()+' RPM in top gear';
  var sb=document.getElementById('swap-tbody');sb.innerHTML='';
  [{label:'Front +1 ('+(f+1)+'T)',front:f+1,rear:r},{label:'Front -1 ('+(f-1)+'T)',front:f-1,rear:r},{label:'Rear +1 ('+(r+1)+'T)',front:f,rear:r+1},{label:'Rear -1 ('+(r-1)+'T)',front:f,rear:r-1}].forEach(function(s){
    if(s.front<1||s.rear<1)return;
    var so=s.rear/s.front,sk=spd(rpm,topGR,so),diff=sk-topK;
    var tr=document.createElement('tr');
    tr.innerHTML='<td>'+s.label+'</td><td>'+so.toFixed(3)+'</td><td>'+sk.toFixed(1)+'</td><td>'+(sk*.621371).toFixed(1)+'</td><td class="'+(diff>=0?'delta-pos':'delta-neg')+'">'+(diff>=0?'+':'')+diff.toFixed(1)+' km/h</td>';
    sb.appendChild(tr);
  });
  document.getElementById('calc-results').style.display='';
  document.getElementById('calc-results').scrollIntoView({behavior:'smooth',block:'start'});
};
</script>
