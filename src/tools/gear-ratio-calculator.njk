<script>
/* ── Local DB selector ── */
(function(){
  var bikes=window.BIKES||[];
  var makes=[...new Set(bikes.map(b=>b.make))].sort();
  var ms=document.getElementById('make-select'),mo=document.getElementById('model-select');
  makes.forEach(function(m){var o=document.createElement('option');o.value=m;o.textContent=m;ms.appendChild(o);});
  ms.addEventListener('change',function(){
    mo.innerHTML='<option value="">-- Select Model --</option>';mo.disabled=true;
    if(!this.value)return;
    bikes.filter(b=>b.make===this.value).forEach(function(b){
      var o=document.createElement('option');o.value=b.model;o.textContent=b.model+' ('+b.year+')';
      o.dataset.front=b.front_sprocket;o.dataset.rear=b.rear_sprocket;o.dataset.tyre=b.rear_tyre||'';
      mo.appendChild(o);
    });
    mo.disabled=false;
  });
  mo.addEventListener('change',function(){
    var s=this.options[this.selectedIndex];
    if(s.dataset.front) document.getElementById('front-sprocket').value=s.dataset.front;
    if(s.dataset.rear)  document.getElementById('rear-sprocket').value=s.dataset.rear;
    if(s.dataset.tyre){
      var m=s.dataset.tyre.match(/^(\d+)\/(\d+)ZR(\d+)|^(\d+)\/(\d+)R(\d+)|^(\d+)\/(\d+)-(\d+)/);
      if(m){
        var w=m[1]||m[4]||m[7],a=m[2]||m[5]||m[8],r=m[3]||m[6]||m[9];
        setSelectByValue('tire-width',w);setSelectByValue('aspect-ratio',a);setSelectByValue('wheel-size',r);
      }
    }
  });
})();

function setSelectByValue(id,val){
  var el=document.getElementById(id);
  for(var i=0;i<el.options.length;i++){if(el.options[i].value==val){el.selectedIndex=i;return;}}
}

/* ── Live API lookup ── */
async function lookupGearRatio() {
  var make  = document.getElementById('api-make-gr').value.trim();
  var model = document.getElementById('api-model-gr').value.trim();
  var container = document.getElementById('api-lookup-gr');

  if (!make || !model) {
    showLookupStatus(container, 'Please enter both a make and model.', 'warn');
    return;
  }

  hideLookupStatus(container);
  showLookupLoading(container);

  try {
    var spec = await fetchBikeSpecs(make, model);
    hideLookupLoading(container);

    if (!spec) {
      showLookupStatus(container, 'No results found. Check the make/model spelling and try again.', 'warn');
      return;
    }

    var notes = [];

    /* ── Transmission: extract gear count and drive type ── */
    if (spec.transmission) {
      var tx = spec.transmission;
      /* e.g. "6-Speed, Chain Drive" or "5 Speed Manual Chain" */
      var gearMatch = tx.match(/(\d)\s*[-\s]?\s*[Ss]peed/);
      if (gearMatch) {
        var gearCount = parseInt(gearMatch[1]);
        var gcSel = document.getElementById('gear-count');
        for (var i=0;i<gcSel.options.length;i++){
          if(parseInt(gcSel.options[i].value)===gearCount){gcSel.selectedIndex=i;break;}
        }
        /* Trigger the display update */
        gcSel.dispatchEvent(new Event('change'));
        notes.push(gearCount + '-speed gearbox detected — gear count updated.');
      }
      var driveType = tx.match(/chain|belt|shaft/i);
      if (driveType) {
        notes.push('Drive type: ' + driveType[0].charAt(0).toUpperCase() + driveType[0].slice(1).toLowerCase() + ' drive confirmed.');
      } else {
        notes.push('Technical specifications incomplete — drive type not listed. Please verify manually.');
      }
    } else {
      notes.push('Technical specifications incomplete — transmission data missing. Please input custom metrics manually.');
    }

    /* ── Rear tyre → pre-fill tyre fields ── */
    if (spec.rear_tire) {
      var t = parseTyreCode(spec.rear_tire);
      if (t) {
        setSelectByValue('tire-width', t.width);
        setSelectByValue('aspect-ratio', t.aspect);
        setSelectByValue('wheel-size', t.rim);
        notes.push('Rear tyre ' + spec.rear_tire + ' applied.');
      }
    }

    /* ── Sprocket data not in API — note it ── */
    notes.push('Note: API Ninjas does not provide sprocket tooth counts. Enter your OEM figures manually.');

    showLookupStatus(container,
      (spec.make||make) + ' ' + (spec.model||model) + ' ' + (spec.year||'') + ' found. ' + notes.join(' '),
      'success'
    );

  } catch(err) {
    hideLookupLoading(container);
    showLookupStatus(container,
      API_KEY === 'YOUR_API_KEY_HERE'
        ? 'API key not set. Add your API Ninjas key to /js/bike-lookup.js to enable live lookup.'
        : 'Lookup failed: ' + err.message + '. You can still enter values manually.',
      'error'
    );
  }
}

/* ── Gear row visibility ── */
(function() {
  var gearCountEl = document.getElementById('gear-count');
  function updateGearRows() {
    var count = parseInt(gearCountEl.value, 10);
    document.querySelectorAll('.gear-row').forEach(function(row) {
      row.style.display = parseInt(row.getAttribute('data-gear'), 10) <= count ? '' : 'none';
    });
  }
  gearCountEl.addEventListener('change', updateGearRows);
  updateGearRows();
})();

/* ── Main calculation ── */
window.calculate = function() {
  var frontTeeth  = parseFloat(document.getElementById('front-sprocket').value);
  var rearTeeth   = parseFloat(document.getElementById('rear-sprocket').value);
  var tireWidth   = parseFloat(document.getElementById('tire-width').value);
  var aspectRatio = parseFloat(document.getElementById('aspect-ratio').value);
  var wheelSizeIn = parseFloat(document.getElementById('wheel-size').value);
  var maxRPM      = parseFloat(document.getElementById('max-rpm').value);
  var gearCount   = parseInt(document.getElementById('gear-count').value, 10);

  if (!frontTeeth||!rearTeeth||!tireWidth||!aspectRatio||!wheelSizeIn||!maxRPM) {
    alert('Please fill in all fields.'); return;
  }

  var tireDiameterMm    = (tireWidth * aspectRatio / 100 * 2) + (wheelSizeIn * 25.4);
  var tireCircumferenceM = Math.PI * tireDiameterMm / 1000;
  var overallRatio = rearTeeth / frontTeeth;

  function calcSpeed(rpm, gearRatio, overall) {
    return (rpm * tireCircumferenceM * 60) / (gearRatio * overall * 1000);
  }

  var tbody = document.getElementById('results-tbody');
  tbody.innerHTML = '';
  for (var g = 1; g <= gearCount; g++) {
    var gr = parseFloat(document.getElementById('gr-'+g).value);
    var skph = calcSpeed(maxRPM, gr, overallRatio);
    var smph = skph * 0.621371;
    var tr = document.createElement('tr');
    tr.innerHTML='<td>Gear '+g+'</td><td>'+gr.toFixed(3)+'</td><td>'+skph.toFixed(1)+'</td><td>'+smph.toFixed(1)+'</td>';
    tbody.appendChild(tr);
  }

  var topGR = parseFloat(document.getElementById('gr-'+gearCount).value);
  var topKmh = calcSpeed(maxRPM, topGR, overallRatio);
  var topMph = topKmh * 0.621371;

  document.getElementById('result-summary').innerHTML =
    '<strong>Overall Drive Ratio:</strong> '+overallRatio.toFixed(3)+
    ' &nbsp;|&nbsp; <strong>Estimated Top Speed:</strong> '+
    topKmh.toFixed(1)+' km/h ('+topMph.toFixed(1)+' mph) at '+maxRPM.toLocaleString()+' RPM in top gear';

  var swapTbody = document.getElementById('swap-tbody');
  swapTbody.innerHTML='';
  [
    {label:'Front +1 ('+(frontTeeth+1)+'T)',front:frontTeeth+1,rear:rearTeeth},
    {label:'Front -1 ('+(frontTeeth-1)+'T)',front:frontTeeth-1,rear:rearTeeth},
    {label:'Rear +1 ('+(rearTeeth+1)+'T)',front:frontTeeth,rear:rearTeeth+1},
    {label:'Rear -1 ('+(rearTeeth-1)+'T)',front:frontTeeth,rear:rearTeeth-1}
  ].forEach(function(s){
    if(s.front<1||s.rear<1)return;
    var so=s.rear/s.front;
    var sk=calcSpeed(maxRPM,topGR,so);
    var sm=sk*0.621371;
    var diff=sk-topKmh;
    var cls=diff>=0?'delta-pos':'delta-neg';
    var tr=document.createElement('tr');
    tr.innerHTML='<td>'+s.label+'</td><td>'+so.toFixed(3)+'</td><td>'+sk.toFixed(1)+'</td><td>'+sm.toFixed(1)+'</td><td class="'+cls+'">'+(diff>=0?'+':'')+diff.toFixed(1)+' km/h</td>';
    swapTbody.appendChild(tr);
  });

  document.getElementById('calc-results').style.display='';
  document.getElementById('calc-results').scrollIntoView({behavior:'smooth',block:'start'});
};
</script>
