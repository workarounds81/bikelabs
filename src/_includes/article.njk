---
layout: base.njk
ogType: article
---

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "url": "{{ page.url | absoluteUrl(site.url) }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ page.url | absoluteUrl(site.url) }}" },
  "datePublished": "{{ page.date | dateISO }}",
  "dateModified": "{{ dateModified or page.date | dateISO }}",
  "inLanguage": "en-US",
  "author": { "@type": "Organization", "name": "BikeLabs Editorial Team", "url": "{{ '/about/' | absoluteUrl(site.url) }}" },
  "publisher": {
    "@type": "Organization",
    "name": "BikeLabs",
    "url": "{{ site.url }}",
    "logo": { "@type": "ImageObject", "url": "{{ '/img/bikelabs-logo-new.png' | absoluteUrl(site.url) }}" }
  }{% if image %},
  "image": {
    "@type": "ImageObject",
    "url": "{{ image | absoluteUrl(site.url) }}",
    "width": 1200,
    "height": 675
  }{% endif %}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}" },
    { "@type": "ListItem", "position": 2, "name": "{{ section | capitalize }}", "item": "{{ ('/' + section + '/') | absoluteUrl(site.url) }}" },
    { "@type": "ListItem", "position": 3, "name": "{{ title }}", "item": "{{ page.url | absoluteUrl(site.url) }}" }
  ]
}
</script>

{% if faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq %}
    {
      "@type": "Question",
      "name": "{{ item.q }}",
      "acceptedAnswer": { "@type": "Answer", "text": "{{ item.a }}" }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endblock %}

{% block content %}
<div class="progress-bar" id="progressBar" aria-hidden="true"></div>

<article class="post">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ '/' | url }}">Home</a>
    <span class="sep">/</span>
    <a href="{{ ('/' + section + '/') | url }}">{{ section | capitalize }}</a>
    <span class="sep">/</span>
    <span>{{ category or "Article" }}</span>
  </nav>

  <header class="post-header">
    <span class="kicker">{{ section }}{% if category %} / {{ category }}{% endif %}</span>
    <h1 class="post-title">{{ title }}</h1>
    <div class="data-strip">
      <span>Published <b>{{ page.date | dateDisplay }}</b></span>
      <span>{{ content | readingTime }}</span>
      <span>By <b>BikeLabs Editorial Team</b></span>
    </div>
  </header>

  {% if image %}
  <img class="post-hero" src="{{ image | url }}" alt="{{ title }}" fetchpriority="high" decoding="async">
  {% endif %}

  {% if affiliate %}
  <div class="affiliate-disclosure">
    This article contains affiliate links. If you buy through our links, we may earn a small commission at no extra cost to you. This never affects our conclusions — read <a href="{{ '/how-we-research/' | url }}">how we research</a>.
  </div>
  {% endif %}

  <div class="article-body">
    {{ content | safe }}
  </div>

  <aside class="byline-box">
    <span class="byline-mark">BL</span>
    <div>
      <h4>BikeLabs Editorial Team</h4>
      <p>Researched and fact-checked by the BikeLabs editorial team. This is a research-led guide: our conclusions are drawn from manufacturer documentation, safety certification data and published independent testing — not from our own hands-on testing. Ratings are editorial assessments, not measurements. Read <a href="{{ '/how-we-research/' | url }}">how we research</a> or <a href="{{ '/about/' | url }}">more about us</a>.</p>
    </div>
  </aside>

  <!-- Related articles -->
  {% set related = collections[section] | default([]) %}
  {% if related | length > 1 %}
  <aside class="related-articles">
    <h2>More {{ section | capitalize }}</h2>
    <div class="card-grid">
      {% for article in related | excludeUrl(page.url) | limit(3) %}
        <article class="article-card">
          <a href="{{ article.url | url }}">
            {% if article.data.image %}
            <div class="card-img-wrap">
              <img src="{{ article.data.image | url }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
            </div>
            {% else %}
            <div class="card-img-placeholder"><span>{{ article.data.category or article.data.section }}</span></div>
            {% endif %}
          </a>
          <div class="card-body">
            <span class="card-tag">{{ article.data.category or article.data.section }}</span>
            <h3 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h3>
            <p class="card-meta">{{ article.date | dateDisplay }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </aside>
  {% endif %}

</article>

<script>
(function () {
  var bar = document.getElementById('progressBar');
  if (!bar) return;
  function update() {
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
})();
</script>
{% endblock %}
