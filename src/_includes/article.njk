---
layout: base.njk
ogType: article
---

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "url": "{{ page.url | absoluteUrl(site.url) }}",
  "datePublished": "{{ page.date | dateISO }}",
  "dateModified": "{{ dateModified or page.date | dateISO }}",
  "inLanguage": "en-US",
  "author": { "@type": "Organization", "name": "BikeLabs Team", "url": "{{ site.url }}" },
  "publisher": {
    "@type": "Organization",
    "name": "BikeLabs",
    "url": "{{ site.url }}",
    "logo": { "@type": "ImageObject", "url": "{{ '/img/bikelabs-logo.png' | absoluteUrl(site.url) }}" }
  }{% if image %},
  "image": {
    "@type": "ImageObject",
    "url": "{{ image | absoluteUrl(site.url) }}",
    "width": 1200,
    "height": 675
  }{% endif %}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}" },
    { "@type": "ListItem", "position": 2, "name": "{{ section | capitalize }}", "item": "{{ ('/' + section + '/') | absoluteUrl(site.url) }}" },
    { "@type": "ListItem", "position": 3, "name": "{{ title }}", "item": "{{ page.url | absoluteUrl(site.url) }}" }
  ]
}
</script>

{% if faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq %}
    {
      "@type": "Question",
      "name": "{{ item.q }}",
      "acceptedAnswer": { "@type": "Answer", "text": "{{ item.a }}" }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endblock %}

{% block content %}
<div class="article-page">
  <div class="ad-column ad-column--left">
    <!-- AdSense left -->
  </div>

  <div class="article-main">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ '/' | url }}">Home</a>
      <span>&rsaquo;</span>
      <a href="{{ ('/' + section + '/') | url }}">{{ section | capitalize }}</a>
      <span>&rsaquo;</span>
      <span>{{ title }}</span>
    </nav>

    <header class="article-header">
      <span class="article-category">{{ category or section }}</span>
      <h1 class="article-title">{{ title }}</h1>
      <div class="article-meta">
        <span>{{ page.date | dateDisplay }}</span>
        <span>By BikeLabs Team</span>
        <span>{{ content | readingTime }}</span>
      </div>
    </header>

    {% if image %}
    <img class="article-hero" src="{{ image | url }}" alt="{{ title }}" fetchpriority="high" decoding="async">
    {% endif %}

    {% if affiliate %}
    <div class="affiliate-disclosure">
      This article contains affiliate links. If you buy through our links, we may earn a small commission at no extra cost to you.
    </div>
    {% endif %}

    <div class="article-body">
      {{ content | safe }}
    </div>

    {% include "partials/ad-slot.njk" %}

    <!-- Related articles -->
    {% set related = collections[section] | default([]) %}
    {% if related | length > 1 %}
    <aside class="related-articles">
      <h2>More {{ section | capitalize }}</h2>
      <div class="card-grid">
        {% for article in related | limit(3) %}
          {% if article.url !== page.url %}
          <article class="article-card">
            <a href="{{ article.url | url }}">
              {% if article.data.image %}
              <div class="card-img-wrap">
                <img src="{{ article.data.image | url }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
              </div>
              {% else %}
              <div class="card-img-placeholder"><span>{{ article.data.category or article.data.section }}</span></div>
              {% endif %}
            </a>
            <div class="card-body">
              <span class="card-tag">{{ article.data.category or article.data.section }}</span>
              <h3 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h3>
              <p class="card-meta">{{ article.date | dateDisplay }}</p>
            </div>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </aside>
    {% endif %}

  </div>

  <div class="ad-column ad-column--right">
    <!-- AdSense right -->
  </div>
</div>
{% endblock %}
