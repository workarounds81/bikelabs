---
layout: base.njk
ogType: article
---

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "url": "{{ page.url | absoluteUrl(site.url) }}",
  "datePublished": "{{ page.date | dateISO }}",
  "dateModified": "{{ dateModified or page.date | dateISO }}",
  "inLanguage": "en-US",
  "author": { "@type": "Organization", "name": "BikeLabs Team", "url": "{{ site.url }}" },
  "publisher": {
    "@type": "Organization",
    "name": "BikeLabs",
    "url": "{{ site.url }}",
    "logo": { "@type": "ImageObject", "url": "{{ '/img/bikelabs-logo.png' | absoluteUrl(site.url) }}" }
  }{% if image %},
  "image": {
    "@type": "ImageObject",
    "url": "{{ image | absoluteUrl(site.url) }}",
    "width": 1200,
    "height": 675
  }{% endif %}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}" },
    { "@type": "ListItem", "position": 2, "name": "Culture", "item": "{{ '/culture/' | absoluteUrl(site.url) }}" },
    { "@type": "ListItem", "position": 3, "name": "{{ title }}", "item": "{{ page.url | absoluteUrl(site.url) }}" }
  ]
}
</script>
{% endblock %}

{% block content %}
<div class="culture-page">
  <div class="ad-column ad-column--left">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-7510624548793689" data-ad-slot="7885005664" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <div class="culture-layout">

    {% if image %}
    <img class="article-hero" src="{{ image | url }}" alt="{{ title }}" fetchpriority="high" decoding="async" style="margin-bottom:2rem;">
    {% endif %}

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ '/' | url }}">Home</a>
      <span>&rsaquo;</span>
      <a href="{{ '/culture/' | url }}">Culture</a>
      <span>&rsaquo;</span>
      <span>{{ title }}</span>
    </nav>

    <header class="article-header">
      <span class="article-category">{{ category or "Culture" }}</span>
      <h1 class="article-title">{{ title }}</h1>
      <div class="article-meta">
        <span>{{ page.date | dateDisplay }}</span>
        <span>By BikeLabs Team</span>
        <span>{{ content | readingTime }}</span>
      </div>
    </header>

    <div class="article-body">
      {{ content | safe }}
    </div>

    {% include "partials/ad-slot.njk" %}

    {% set related = collections.culture | default([]) %}
    {% if related | length > 1 %}
    <aside class="related-articles">
      <h2>More Culture</h2>
      <div class="card-grid-2">
        {% for article in related | limit(2) %}
          {% if article.url !== page.url %}
          <article class="article-card">
            <a href="{{ article.url | url }}">
              {% if article.data.image %}
              <div class="card-img-wrap">
                <img src="{{ article.data.image | url }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
              </div>
              {% else %}
              <div class="card-img-placeholder"><span>Culture</span></div>
              {% endif %}
            </a>
            <div class="card-body">
              <span class="card-tag">Culture</span>
              <h3 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h3>
              <p class="card-meta">{{ article.date | dateDisplay }}</p>
            </div>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </aside>
    {% endif %}

  </div>

  <div class="ad-column ad-column--right">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-7510624548793689" data-ad-slot="7885005664" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
</div>
{% endblock %}
