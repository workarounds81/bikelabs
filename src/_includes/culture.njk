---
layout: base.njk
ogType: article
---

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "url": "{{ page.url | absoluteUrl(site.url) }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ page.url | absoluteUrl(site.url) }}" },
  "datePublished": "{{ page.date | dateISO }}",
  "dateModified": "{{ dateModified or page.date | dateISO }}",
  "inLanguage": "en-US",
  "author": { "@type": "Organization", "name": "BikeLabs Editorial Team", "url": "{{ '/about/' | absoluteUrl(site.url) }}" },
  "publisher": {
    "@type": "Organization",
    "name": "BikeLabs",
    "url": "{{ site.url }}",
    "logo": { "@type": "ImageObject", "url": "{{ '/img/bikelabs-logo-new.png' | absoluteUrl(site.url) }}" }
  }{% if image %},
  "image": {
    "@type": "ImageObject",
    "url": "{{ image | absoluteUrl(site.url) }}",
    "width": 1200,
    "height": 675
  }{% endif %}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}" },
    { "@type": "ListItem", "position": 2, "name": "Culture", "item": "{{ '/culture/' | absoluteUrl(site.url) }}" },
    { "@type": "ListItem", "position": 3, "name": "{{ title }}", "item": "{{ page.url | absoluteUrl(site.url) }}" }
  ]
}
</script>
{% endblock %}

{% block content %}
<div class="progress-bar" id="progressBar" aria-hidden="true"></div>

<article class="post">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ '/' | url }}">Home</a>
    <span class="sep">/</span>
    <a href="{{ '/culture/' | url }}">Culture</a>
    <span class="sep">/</span>
    <span>{{ category or "Feature" }}</span>
  </nav>

  <header class="post-header">
    <span class="kicker">culture{% if category %} / {{ category }}{% endif %}</span>
    <h1 class="post-title">{{ title }}</h1>
    <div class="data-strip">
      <span>Published <b>{{ page.date | dateDisplay }}</b></span>
      <span>{{ content | readingTime }}</span>
      <span>By <b>BikeLabs Editorial Team</b></span>
    </div>
  </header>

  {% if image %}
  <img class="post-hero" src="{{ image | url }}" alt="{{ title }}" fetchpriority="high" decoding="async">
  {% endif %}

  <div class="article-body">
    {{ content | safe }}
  </div>

  <aside class="byline-box">
    <span class="byline-mark">BL</span>
    <div>
      <h4>BikeLabs Editorial Team</h4>
      <p>Researched and fact-checked by the BikeLabs editorial team. Our culture and routes coverage is compiled from published sources, rider community reports and official route and event information rather than first-hand travel. Read <a href="{{ '/how-we-research/' | url }}">how we research</a> or <a href="{{ '/about/' | url }}">more about us</a>.</p>
    </div>
  </aside>

  {% set related = collections.culture | default([]) %}
  {% if related | length > 1 %}
  <aside class="related-articles">
    <h2>More Culture</h2>
    <div class="card-grid">
      {% for article in related | excludeUrl(page.url) | limit(3) %}
        <article class="article-card">
          <a href="{{ article.url | url }}">
            {% if article.data.image %}
            <div class="card-img-wrap">
              <img src="{{ article.data.image | url }}" alt="{{ article.data.title }}" loading="lazy" decoding="async">
            </div>
            {% else %}
            <div class="card-img-placeholder"><span>Culture</span></div>
            {% endif %}
          </a>
          <div class="card-body">
            <span class="card-tag">culture</span>
            <h3 class="card-title"><a href="{{ article.url | url }}">{{ article.data.title }}</a></h3>
            <p class="card-meta">{{ article.date | dateDisplay }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </aside>
  {% endif %}

</article>

<script>
(function () {
  var bar = document.getElementById('progressBar');
  if (!bar) return;
  function update() {
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
})();
</script>
{% endblock %}
