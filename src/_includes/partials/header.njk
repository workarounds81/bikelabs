<header class="site-header">
  <div class="header-inner">
    <a href="{{ '/' | url }}" class="wordmark" aria-label="BikeLabs — home">
      BIKE<em>LABS</em><span class="wordmark-sub">DATA DRIVEN. RIDER PROVEN.</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
    <label for="nav-toggle" class="hamburger" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>

    <nav class="main-nav" aria-label="Main navigation">
      <a href="{{ '/reviews/' | url }}"{% if '/reviews/' in page.url %} class="active"{% endif %}>Reviews</a>
      <a href="{{ '/bikes/' | url }}"{% if '/bikes/' in page.url %} class="active"{% endif %}>Bikes</a>
      <a href="{{ '/culture/' | url }}"{% if '/culture/' in page.url %} class="active"{% endif %}>Culture</a>
      <a href="{{ '/how-to/' | url }}"{% if '/how-to/' in page.url %} class="active"{% endif %}>How-To</a>
      <a href="{{ '/tools/' | url }}"{% if '/tools/' in page.url %} class="active"{% endif %}>The Lab</a>
      <a href="{{ '/about/' | url }}"{% if '/about/' in page.url %} class="active"{% endif %}>About</a>
    </nav>
  </div>
</header>
